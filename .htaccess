# =========================================================
# Understand Studio — configuración del servidor (Hostinger)
# =========================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType text/plain .txt

# --- Redirección: sin www (una sola URL para Google). El paso a https lo hace el CDN de Hostinger ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.understandstudio\.com\.ar$ [NC]
  RewriteRule ^(.*)$ https://understandstudio.com.ar/$1 [R=301,L]
  # La página de relleno de Hostinger no se publica
  RewriteRule ^default\.php$ / [R=301,L]
</IfModule>

# --- Archivos ocultos y de trabajo: no se sirven ---
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/\.(?!well-known/)
  RedirectMatch 404 (?i)\.(md|py|sh|bak|log|sql|zip)$
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'sha256-GvGCK6bDJve7vhzhUIPyo2L0IqXpWoKivtnPlzV3Up4='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # Caché: el HTML siempre se revalida (los cambios se ven al instante);
  # CSS y JS una hora; imágenes y fuentes un mes.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/plain text/xml application/xml
</IfModule>
